# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Data
# Raw downloads are never committed - they are reproducible from each
# project's data/README.md. Cleaned "processed" data may be committed if
# small (< ~5 MB) so the Quarto site can build in CI.
# ---------------------------------------------------------------------------
data/raw/
projects/*/data/raw/
projects/*/data/interim/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3

# Individual large processed files that exceed the ~5MB commit guideline and
# are fully reproducible by rerunning that project's notebook or SQL.
projects/06-energy-power-plants/data/processed/power_plants_clean.csv
projects/01-tfl-cycling/data/processed/*.duckdb

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env

# ---------------------------------------------------------------------------
# Quarto site build output
# ---------------------------------------------------------------------------
/site/_site/
/site/.quarto/

# ---------------------------------------------------------------------------
# macOS / editors
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
